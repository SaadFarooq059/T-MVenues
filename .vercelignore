# NOTE: once this file exists, Vercel uses it INSTEAD of .gitignore,
# so everything that must never be uploaded has to be listed here.

# --- Never upload: secrets & local env ---
.env
.env*.local
public/.env
scripts/.env

# --- Never upload: local-only tooling & docs ---
scripts/
*.py
*.pdf
report_alarms_*.csv

# --- Build / dependency dirs (Vercel installs & builds these itself) ---
node_modules
.next
.vercel
*.tsbuildinfo
.git
.claude

# --- v0 sandbox leftovers ---
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/

# --- Unused media (~150 MB): kept on disk, not shipped to production ---
public/Journey/
public/video1.mp4
public/can_you_use_our_logo_also.mp4
